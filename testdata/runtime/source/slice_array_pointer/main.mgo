package main
func Main() int {
 s := []int{1, 2, 3, 4}; p := (*[2]int)(s[1:]); q := (*[2]int)(s[1:])
 if p != q || p == (*[2]int)(s) { return -1 }
 identity := 0; if &p[0] == &s[1] { identity = 100 }
 *p = [2]int{20, 22}; copy := *p; copy[0] = 0
 if s[1] != 20 || s[2] != 22 || p[0] != 20 { return -2 }
 p[1] = 21; view := p[:]; view[1]++; if s[2] != 22 { return -3 }
 var empty []int; if (*[0]int)(empty) != nil || (*[0]int)(s[:0]) == nil { return -4 }
 return s[1] + s[2] + identity
}
