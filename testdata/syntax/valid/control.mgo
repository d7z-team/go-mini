package main

func sum(values []int) int {
	total := 0
	for _, value := range values {
		total += value
	}
	return total
}

func receive(ch chan int) int {
	select {
	case value := <-ch:
		return value
	default:
		return 0
	}
}

func main() {
	_ = sum([]int{1, 2, 3})
	ch := make(chan int, 1)
	ch <- 4
	_ = receive(ch)
}
