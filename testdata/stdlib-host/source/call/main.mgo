package main

import "fmt"
import "os"
import "errors"

func Main() int {
	missing, err := os.Open("missing")
	if missing != nil || !errors.Is(err, os.ErrNotExist) { return -1 }
	file, err := os.Create("created")
	if err != nil { return -2 }
	n, err := file.Write([]byte("answer"))
	if err != nil || n != 6 { return -3 }
	if _, err := file.Seek(0, 0); err != nil { return -4 }
	data := make([]byte, 6)
	n, err = file.Read(data)
	if err != nil || n != 6 || string(data) != "answer" { return -5 }
	if err := file.Close(); err != nil { return -6 }
	value, found := os.LookupEnv("ANSWER")
	if !found || value != "42" { return -7 }
	fmt.Print("answer=42")
	return 42
}
