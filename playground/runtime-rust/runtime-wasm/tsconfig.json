{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "sdk",
    "outDir": ".build/dist",
    "noEmitOnError": true
  },
  "include": ["sdk/**/*.ts"]
}
