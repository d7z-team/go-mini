// Package net provides portable network interfaces and in-memory connections.
package net

import (
	"io"
	"os"
	"sync"
	"time"
)

// Addr represents a network end point address.
//
// The two methods [Addr.Network] and [Addr.String] conventionally return strings
// that can be passed as the arguments to [Dial], but the exact form
// and meaning of the strings is up to the implementation.
type Addr interface {
	// name of the network (for example, "tcp", "udp")
	Network() string
	// string form of address (for example, "192.0.2.1:25", "[2001:db8::1]:80")
	String() string
}

// Conn is a generic stream-oriented network connection.
//
// Multiple goroutines may invoke methods on a Conn simultaneously.
type Conn interface {
	// Read reads data from the connection.
	// Read can be made to time out and return an error after a fixed
	// time limit; see SetDeadline and SetReadDeadline.
	Read([]byte) (int, error)
	// Write writes data to the connection.
	// Write can be made to time out and return an error after a fixed
	// time limit; see SetDeadline and SetWriteDeadline.
	Write([]byte) (int, error)
	// Close closes the connection.
	// Any blocked Read or Write operations will be unblocked and return errors.
	// Close may or may not block until any buffered data is sent;
	// for TCP connections see [*TCPConn.SetLinger].
	Close() error
	// LocalAddr returns the local network address, if known.
	LocalAddr() Addr
	// RemoteAddr returns the remote network address, if known.
	RemoteAddr() Addr
	// SetDeadline sets the read and write deadlines associated
	// with the connection. It is equivalent to calling both
	// SetReadDeadline and SetWriteDeadline.
	//
	// A deadline is an absolute time after which I/O operations
	// fail instead of blocking. The deadline applies to all future
	// and pending I/O, not just the immediately following call to
	// Read or Write. After a deadline has been exceeded, the
	// connection can be refreshed by setting a deadline in the future.
	//
	// If the deadline is exceeded a call to Read or Write or to other
	// I/O methods will return an error that wraps os.ErrDeadlineExceeded.
	// This can be tested using errors.Is(err, os.ErrDeadlineExceeded).
	// The error's Timeout method will return true, but note that there
	// are other possible errors for which the Timeout method will
	// return true even if the deadline has not been exceeded.
	//
	// An idle timeout can be implemented by repeatedly extending
	// the deadline after successful Read or Write calls.
	//
	// A zero value for t means I/O operations will not time out.
	SetDeadline(time.Time) error
	// SetReadDeadline sets the deadline for future Read calls
	// and any currently-blocked Read call.
	// A zero value for t means Read will not time out.
	SetReadDeadline(time.Time) error
	// SetWriteDeadline sets the deadline for future Write calls
	// and any currently-blocked Write call.
	// Even if write times out, it may return n > 0, indicating that
	// some of the data was successfully written.
	// A zero value for t means Write will not time out.
	SetWriteDeadline(time.Time) error
}

type pipeAddr int

func (pipeAddr) Network() string {
	return "pipe"
}

func (pipeAddr) String() string {
	return "pipe"
}

type pipeConn struct {
	readData <-chan []byte
	readAck chan<- int
	writeData chan<- []byte
	writeAck <-chan int
	localDone chan struct{}
	remoteDone <-chan struct{}
	readMutex sync.Mutex
	writeMutex sync.Mutex
	closeOnce sync.Once
	readDeadline pipeDeadline
	writeDeadline pipeDeadline
}

type pipeDeadline struct {
	guard sync.Mutex
	when time.Time
	changed chan struct{}
	closed bool
	timer *time.Timer
}

func (deadline *pipeDeadline) set(when time.Time) {
	deadline.guard.Lock()
	if deadline.timer != nil {
		deadline.timer.Stop()
		deadline.timer = nil
	}
	if deadline.changed != nil && !deadline.closed {
		close(deadline.changed)
	}
	deadline.when = when
	deadline.changed = nil
	deadline.closed = false
	if when.IsZero() {
		deadline.guard.Unlock()
		return
	}
	changed := make(chan struct{})
	deadline.changed = changed
	duration := time.Until(when)
	if duration <= 0 {
		deadline.closed = true
		close(changed)
		deadline.guard.Unlock()
		return
	}
	deadline.timer = time.AfterFunc(duration, func() {
		deadline.guard.Lock()
		if deadline.changed == changed && !deadline.closed {
			deadline.closed = true
			close(changed)
		}
		deadline.guard.Unlock()
	})
	deadline.guard.Unlock()
}

func (deadline *pipeDeadline) wait() <-chan struct{} {
	deadline.guard.Lock()
	defer deadline.guard.Unlock()
	return deadline.changed
}

func (deadline *pipeDeadline) expired() bool {
	deadline.guard.Lock()
	defer deadline.guard.Unlock()
	return !deadline.when.IsZero() && time.Until(deadline.when) <= 0
}

// Pipe creates a synchronous, in-memory, full duplex
// network connection; both ends implement the [Conn] interface.
// Reads on one end are matched with writes on the other,
// copying data directly between the two; there is no internal
// buffering.
func Pipe() (Conn, Conn) {
	leftToRight := make(chan []byte)
	leftWriteAck := make(chan int, 1)
	rightToLeft := make(chan []byte)
	rightWriteAck := make(chan int, 1)
	leftDone := make(chan struct{})
	rightDone := make(chan struct{})
	left := &pipeConn{
		readData: rightToLeft, readAck: rightWriteAck,
		writeData: leftToRight, writeAck: leftWriteAck,
		localDone: leftDone, remoteDone: rightDone,
	}
	right := &pipeConn{
		readData: leftToRight, readAck: leftWriteAck,
		writeData: rightToLeft, writeAck: rightWriteAck,
		localDone: rightDone, remoteDone: leftDone,
	}
	return left, right
}

func (connection *pipeConn) Read(buffer []byte) (int, error) {
	connection.readMutex.Lock()
	defer connection.readMutex.Unlock()
	for {
		deadline := connection.readDeadline.wait()
		select {
			case data := <-connection.readData:
				count := copy(buffer, data)
				connection.readAck <- count
				return count, nil
			case <-connection.localDone:
				return 0, io.ErrClosedPipe
			case <-connection.remoteDone:
				return 0, io.EOF
			case <-deadline:
				if connection.readDeadline.expired() {
					return 0, os.ErrDeadlineExceeded
				}
		}
	}
}

func (connection *pipeConn) Write(data []byte) (int, error) {
	connection.writeMutex.Lock()
	defer connection.writeMutex.Unlock()
	written := 0
	first := true
	for first || len(data) != 0 {
		first = false
		if connection.writeDeadline.expired() {
			return written, os.ErrDeadlineExceeded
		}
		select {
			case <-connection.localDone:
				return written, io.ErrClosedPipe
			case <-connection.remoteDone:
				return written, io.ErrClosedPipe
			default:
		}
		deadline := connection.writeDeadline.wait()
		select {
			case connection.writeData <- data:
			case <-connection.localDone:
				return written, io.ErrClosedPipe
			case <-connection.remoteDone:
				return written, io.ErrClosedPipe
			case <-deadline:
				continue
		}
		count := <-connection.writeAck
		written += count
		data = data[count:]
	}
	return written, nil
}

func (connection *pipeConn) Close() error {
	connection.closeOnce.Do(func() {
		close(connection.localDone)
	})
	return nil
}

func (*pipeConn) LocalAddr() Addr {
	return pipeAddr(0)
}

func (*pipeConn) RemoteAddr() Addr {
	return pipeAddr(0)
}

func (connection *pipeConn) SetDeadline(deadline time.Time) error {
	if connection.isClosed() {
		return io.ErrClosedPipe
	}
	connection.readDeadline.set(deadline)
	connection.writeDeadline.set(deadline)
	return nil
}

func (connection *pipeConn) SetReadDeadline(deadline time.Time) error {
	if connection.isClosed() {
		return io.ErrClosedPipe
	}
	connection.readDeadline.set(deadline)
	return nil
}

func (connection *pipeConn) SetWriteDeadline(deadline time.Time) error {
	if connection.isClosed() {
		return io.ErrClosedPipe
	}
	connection.writeDeadline.set(deadline)
	return nil
}

func (connection *pipeConn) isClosed() bool {
	select {
		case <-connection.localDone:
			return true
		case <-connection.remoteDone:
			return true
		default:
			return false
	}
}
