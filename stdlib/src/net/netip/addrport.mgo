package netip

import (
	"errors"
	"strconv"
	"strings"
)

// AddrPort is an IP and a port number.
type AddrPort struct {
	address Addr
	port uint16
}

// AddrPortFrom returns an [AddrPort] with the provided IP and port.
// It does not allocate.
func AddrPortFrom(address Addr, port uint16) AddrPort {
	return AddrPort{address: address, port: port}
}

// Addr returns p's IP address.
func (value AddrPort) Addr() Addr {
	return value.address
}

// Port returns p's port.
func (value AddrPort) Port() uint16 {
	return value.port
}

// IsValid reports whether p.Addr() is valid.
// All ports are valid, including zero.
func (value AddrPort) IsValid() bool {
	return value.address.IsValid()
}

// ParseAddrPort parses s as an [AddrPort].
//
// It doesn't do any name resolution: both the address and the port
// must be numeric.
func ParseAddrPort(value string) (AddrPort, error) {
	host, portText := "", ""
	if len(value) > 0 && value[0] == '[' {
		end := strings.LastIndex(value, "]:")
		if end < 0 {
			return AddrPort{}, errors.New("invalid address:port")
		}
		host, portText = value[1:end], value[end + 2:]
	} else {
		colon := strings.LastIndex(value, ":")
		if colon < 0 {
			return AddrPort{}, errors.New("invalid address:port")
		}
		host, portText = value[:colon], value[colon + 1:]
	}
	address, err := ParseAddr(host)
	if err != nil {
		return AddrPort{}, err
	}
	port, err := strconv.ParseUint(portText, 10, 16)
	if err != nil {
		return AddrPort{}, errors.New("invalid port")
	}
	return AddrPortFrom(address, uint16(port)), nil
}

// MustParseAddrPort calls [ParseAddrPort](s) and panics on error.
// It is intended for use in tests with hard-coded strings.
func MustParseAddrPort(value string) AddrPort {
	address, err := ParseAddrPort(value)
	if err != nil {
		panic("ParseAddrPort(" + value + "): " + err.Error())
	}
	return address
}

// String returns the address and port in host:port form.
func (value AddrPort) String() string {
	if !value.IsValid() {
		return "invalid AddrPort"
	}
	host := value.address.String()
	if value.address.Is6() {
		host = "[" + host + "]"
	}
	return host + ":" + strconv.Itoa(int(value.port))
}

// Compare returns an integer comparing two AddrPorts.
// The result will be 0 if p == p2, -1 if p < p2, and +1 if p > p2.
// AddrPorts sort first by IP address, then port.
func (value AddrPort) Compare(other AddrPort) int {
	if comparison := value.address.Compare(other.address); comparison != 0 {
		return comparison
	}
	if value.port < other.port {
		return -1
	}
	if value.port > other.port {
		return 1
	}
	return 0
}

// MarshalText implements the [encoding.TextMarshaler] interface. The
// encoding is the same as returned by [AddrPort.String], with one exception: if
// p.Addr() is the zero [Addr], the encoding is the empty string.
func (value AddrPort) MarshalText() ([]byte, error) {
	if !value.IsValid() {
		return nil, errors.New("invalid AddrPort")
	}
	return []byte(value.String()), nil
}

// AppendText implements the [encoding.TextAppender] interface. The
// encoding is the same as returned by [AddrPort.AppendTo].
func (value AddrPort) AppendText(dst []byte) ([]byte, error) {
	text, err := value.MarshalText()
	return append(dst, text...), err
}

// AppendTo appends a text encoding of p,
// as generated by [AddrPort.MarshalText],
// to b and returns the extended buffer.
func (value AddrPort) AppendTo(dst []byte) []byte {
	return append(dst, []byte(value.String())...)
}

// MarshalBinary implements the [encoding.BinaryMarshaler] interface.
// It returns [Addr.MarshalBinary] with an additional two bytes appended
// containing the port in little-endian.
func (value AddrPort) MarshalBinary() ([]byte, error) {
	data, err := value.address.MarshalBinary()
	if err != nil {
		return nil, err
	}
	return append(data, byte(value.port >> 8), byte(value.port)), nil
}

// AppendBinary implements the [encoding.BinaryAppendler] interface.
// It returns [Addr.AppendBinary] with an additional two bytes appended
// containing the port in little-endian.
func (value AddrPort) AppendBinary(dst []byte) ([]byte, error) {
	data, err := value.MarshalBinary()
	return append(dst, data...), err
}

// UnmarshalText implements the encoding.TextUnmarshaler
// interface. The [AddrPort] is expected in a form
// generated by [AddrPort.MarshalText] or accepted by [ParseAddrPort].
func (value *AddrPort) UnmarshalText(data []byte) error {
	parsed, err := ParseAddrPort(string(data))
	if err == nil {
		*value = parsed
	}
	return err
}

// UnmarshalBinary implements the [encoding.BinaryUnmarshaler] interface.
// It expects data in the form generated by [AddrPort.MarshalBinary].
func (value *AddrPort) UnmarshalBinary(data []byte) error {
	if len(data) != 6 && len(data) < 18 {
		return errors.New("invalid AddrPort binary length")
	}
	addressLength := len(data) - 2
	var address Addr
	if err := address.UnmarshalBinary(data[:addressLength]); err != nil {
		return err
	}
	*value = AddrPortFrom(address, uint16(data[addressLength]) << 8 | uint16(data[addressLength + 1]))
	return nil
}
