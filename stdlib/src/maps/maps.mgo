// Package maps defines various functions useful with maps of any type.
package maps

import "iter"

// Equal reports whether two maps contain the same key-value pairs.
func Equal[M1, M2 ~ map[K]V, K, V comparable](left M1, right M2) bool {
	if len(left) != len(right) {
		return false
	}
	for key, leftValue := range left {
		rightValue, ok := right[key]
		if !ok || leftValue != rightValue {
			return false
		}
	}
	return true
}

// EqualFunc reports whether two maps contain matching keys and equal values.
func EqualFunc[M1 ~ map[K]V1, M2 ~ map[K]V2, K comparable, V1, V2 any](left M1, right M2, equal func(V1, V2) bool) bool {
	if len(left) != len(right) {
		return false
	}
	for key, leftValue := range left {
		rightValue, ok := right[key]
		if !ok || !equal(leftValue, rightValue) {
			return false
		}
	}
	return true
}

// Clone returns a shallow copy of source, preserving nil.
func Clone[M ~ map[K]V, K comparable, V any](source M) M {
	if source == nil {
		return nil
	}
	clone := make(M, len(source))
	for key, value := range source {
		clone[key] = value
	}
	return clone
}

// Copy copies all key-value pairs from source into destination.
func Copy[M1 ~ map[K]V, M2 ~ map[K]V, K comparable, V any](destination M1, source M2) {
	for key, value := range source {
		destination[key] = value
	}
}

// DeleteFunc deletes entries for which remove returns true.
func DeleteFunc[M ~ map[K]V, K comparable, V any](mapping M, remove func(K, V) bool) {
	for key, value := range mapping {
		if remove(key, value) {
			delete(mapping, key)
		}
	}
}

// All returns an iterator over key-value pairs from mapping.
func All[Map ~ map[K]V, K comparable, V any](mapping Map) iter.Seq2[K, V] {
	return func(yield func(K, V) bool) {
		for key, value := range mapping {
			if !yield(key, value) {
				return
			}
		}
	}
}

// Keys returns an iterator over keys from mapping.
func Keys[Map ~ map[K]V, K comparable, V any](mapping Map) iter.Seq[K] {
	return func(yield func(K) bool) {
		for key := range mapping {
			if !yield(key) {
				return
			}
		}
	}
}

// Values returns an iterator over values from mapping.
func Values[Map ~ map[K]V, K comparable, V any](mapping Map) iter.Seq[V] {
	return func(yield func(V) bool) {
		for _, value := range mapping {
			if !yield(value) {
				return
			}
		}
	}
}

// Insert adds key-value pairs from seq to mapping.
func Insert[Map ~ map[K]V, K comparable, V any](mapping Map, seq iter.Seq2[K, V]) {
	for key, value := range seq {
		mapping[key] = value
	}
}

// Collect collects key-value pairs from seq into a new map.
func Collect[K comparable, V any](seq iter.Seq2[K, V]) map[K]V {
	mapping := make(map[K]V)
	for key, value := range seq {
		mapping[key] = value
	}
	return mapping
}
