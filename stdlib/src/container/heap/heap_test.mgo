package heap_test

import (
	"container/heap"
	"testing"
)

type intHeap []int

func (h intHeap) Len() int {
	return len(h)
}

func (h intHeap) Less(i int, j int) bool {
	return h[i] < h[j]
}

func (h intHeap) Swap(i int, j int) {
	h[i], h[j] = h[j], h[i]
}

func (h *intHeap) Push(value any) {
	*h = append(*h, value.(int))
}

func (h *intHeap) Pop() any {
	old := *h
	last := len(old) - 1
	value := old[last]
	*h = old[:last]
	return value
}

func TestHeapInitPushAndPop(t *testing.T) {
	values := intHeap{5, 1, 4, 2, 3}
	heap.Init(&values)
	if values[0] != 1 {
		t.Fatal("Init did not establish the minimum heap")
	}
	heap.Push(&values, 0)
	if values[0] != 0 {
		t.Fatal("Push did not move the new minimum to the root")
	}
	if heap.Pop(&values).(int) != 0 {
		t.Fatal("Pop returned the wrong minimum")
	}
	if heap.Pop(&values).(int) != 1 {
		t.Fatal("Pop did not preserve heap ordering")
	}
}

func TestHeapRemoveAndFix(t *testing.T) {
	values := intHeap{1, 2, 3, 4, 5}
	heap.Init(&values)
	values[3] = 0
	heap.Fix(&values, 3)
	if values[0] != 0 {
		t.Fatal("Fix did not move a decreased value upward")
	}
	removed := heap.Remove(&values, 1).(int)
	if removed != 1 {
		t.Fatalf("Remove returned %d, want 1", removed)
	}
	previous := values[0]
	for i := 1; i < len(values); i++ {
		if values[i] < previous {
			t.Fatal("Remove broke heap ordering")
		}
		previous = values[i]
	}
}
