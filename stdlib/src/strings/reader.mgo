package strings

import "io"

// A Reader implements the [io.Reader], [io.ReaderAt], [io.ByteReader], [io.ByteScanner],
// [io.RuneReader], [io.RuneScanner], [io.Seeker], and [io.WriterTo] interfaces by reading
// from a string.
// The zero value for Reader operates like a Reader of an empty string.
type Reader struct {
	s string
	offset int
	lastKind int
	lastSize int
}

// NewReader returns a new [Reader] reading from s.
// It is similar to [bytes.NewBufferString] but more efficient and non-writable.
func NewReader(s string) *Reader {
	reader := new(Reader)
	reader.s = s
	return reader
}

// Reset resets the [Reader] to be reading from s.
func (r *Reader) Reset(s string) {
	if r == nil {
		return
	}
	r.s = s
	r.offset = 0
	r.lastKind = 0
	r.lastSize = 0
}

// Len returns the number of bytes of the unread portion of the
// string.
func (r *Reader) Len() int {
	if r == nil || r.offset >= len(r.s) {
		return 0
	}
	return len(r.s) - r.offset
}

// Size returns the original length of the underlying string.
// Size is the number of bytes available for reading via [Reader.ReadAt].
// The returned value is always the same and is not affected by calls
// to any other method.
func (r *Reader) Size() int64 {
	if r == nil {
		return 0
	}
	return int64(len(r.s))
}

// Read implements the [io.Reader] interface.
func (r *Reader) Read(p []byte) (int, error) {
	if r == nil || r.offset >= len(r.s) {
		return 0, io.EOF
	}
	n := copy(p, []byte(r.s[r.offset:]))
	r.offset += n
	r.lastKind = 0
	r.lastSize = 0
	return n, nil
}

// ReadAt implements the [io.ReaderAt] interface.
func (r *Reader) ReadAt(p []byte, offset int64) (int, error) {
	if r == nil || offset < 0 || offset >= int64(len(r.s)) {
		return 0, io.EOF
	}
	n := len(p)
	available := int64(len(r.s)) - offset
	if int64(n) > available {
		n = int(available)
	}
	copy(p[:n], []byte(r.s[int(offset):int(offset) + n]))
	if n < len(p) {
		return n, io.EOF
	}
	return n, nil
}

// ReadByte implements the [io.ByteReader] interface.
func (r *Reader) ReadByte() (byte, error) {
	if r == nil || r.offset >= len(r.s) {
		return 0, io.EOF
	}
	value := r.s[r.offset]
	r.offset++
	r.lastKind = 1
	r.lastSize = 1
	return value, nil
}

// UnreadByte implements the [io.ByteScanner] interface.
func (r *Reader) UnreadByte() error {
	if r == nil || r.lastKind != 1 {
		return errUnreadByte
	}
	r.offset -= r.lastSize
	r.lastKind = 0
	r.lastSize = 0
	return nil
}

// ReadRune implements the [io.RuneReader] interface.
func (r *Reader) ReadRune() (rune, int, error) {
	if r == nil || r.offset >= len(r.s) {
		return 0, 0, io.EOF
	}
	for _, value := range r.s[r.offset:] {
		size := len(string(value))
		r.offset += size
		r.lastKind = 2
		r.lastSize = size
		return value, size, nil
	}
	return 0, 0, io.EOF
}

// UnreadRune implements the [io.RuneScanner] interface.
func (r *Reader) UnreadRune() error {
	if r == nil || r.lastKind != 2 {
		return errUnreadRune
	}
	r.offset -= r.lastSize
	r.lastKind = 0
	r.lastSize = 0
	return nil
}

// Seek implements the [io.Seeker] interface.
func (r *Reader) Seek(offset int64, whence int) (int64, error) {
	if r == nil {
		return 0, errNegativePosition
	}
	newOffset := int64(r.offset)
	switch whence {
		case io.SeekStart:
			newOffset = offset
		case io.SeekCurrent:
			newOffset += offset
		case io.SeekEnd:
			newOffset = int64(len(r.s)) + offset
		default:
			return 0, errInvalidWhence
	}
	if newOffset < 0 {
		return 0, errNegativePosition
	}
	r.offset = int(newOffset)
	r.lastKind = 0
	r.lastSize = 0
	return newOffset, nil
}

// WriteTo implements the [io.WriterTo] interface.
func (r *Reader) WriteTo(w io.Writer) (int64, error) {
	if r == nil || r.offset >= len(r.s) {
		return 0, nil
	}
	n, err := w.Write([]byte(r.s[r.offset:]))
	r.offset += n
	r.lastKind = 0
	r.lastSize = 0
	return int64(n), err
}
