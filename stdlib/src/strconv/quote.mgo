package strconv

import (
	"unicode"
)

// AppendBool appends "true" or "false", according to the value of b,
// to dst and returns the extended buffer.
func AppendBool(dst []byte, b bool) []byte {
	return append(dst, []byte(FormatBool(b))...)
}

// AppendInt appends the string form of the integer i,
// as generated by [FormatInt], to dst and returns the extended buffer.
func AppendInt(dst []byte, i int64, base int) []byte {
	return append(dst, []byte(FormatInt(i, base))...)
}

// AppendUint appends the string form of the unsigned integer i,
// as generated by [FormatUint], to dst and returns the extended buffer.
func AppendUint(dst []byte, i uint64, base int) []byte {
	return append(dst, []byte(FormatUint(i, base))...)
}

// AppendFloat appends the string form of the floating-point number f,
// as generated by [FormatFloat], to dst and returns the extended buffer.

// AppendQuote appends a double-quoted Go string literal representing s.
func AppendQuote(dst []byte, s string) []byte {
	return append(dst, []byte(Quote(s))...)
}

// AppendQuoteToASCII appends an ASCII-only quoted Go string literal.
func AppendQuoteToASCII(dst []byte, s string) []byte {
	return append(dst, []byte(QuoteToASCII(s))...)
}

// AppendQuoteToGraphic appends a quoted literal that leaves graphic runes
// unescaped.
func AppendQuoteToGraphic(dst []byte, s string) []byte {
	return append(dst, []byte(QuoteToGraphic(s))...)
}

// AppendQuoteRune appends a quoted Go rune literal.
func AppendQuoteRune(dst []byte, r rune) []byte {
	return append(dst, []byte(QuoteRune(r))...)
}

// AppendQuoteRuneToASCII appends an ASCII-only quoted rune literal.
func AppendQuoteRuneToASCII(dst []byte, r rune) []byte {
	return append(dst, []byte(QuoteRuneToASCII(r))...)
}

// AppendQuoteRuneToGraphic appends a quoted graphic rune literal.
func AppendQuoteRuneToGraphic(dst []byte, r rune) []byte {
	return append(dst, []byte(QuoteRuneToGraphic(r))...)
}

// Quote returns a double-quoted Go string literal representing s. The
// returned string uses Go escape sequences (\t, \n, \xFF, \u0100) for
// control characters and non-printable characters as defined by
// [IsPrint].
func Quote(s string) string {
	return quoteString(s, false, false)
}

// QuoteToASCII returns a double-quoted Go string literal representing s.
// The returned string uses Go escape sequences (\t, \n, \xFF, \u0100) for
// non-ASCII characters and non-printable characters as defined by [IsPrint].
func QuoteToASCII(s string) string {
	return quoteString(s, true, false)
}

// QuoteToGraphic returns a quoted Go string literal, leaving Unicode graphic
// characters unchanged.
func QuoteToGraphic(s string) string {
	return quoteString(s, false, true)
}

// QuoteRune returns a single-quoted Go character literal representing the
// rune. The returned string uses Go escape sequences (\t, \n, \xFF, \u0100)
// for control characters and non-printable characters as defined by [IsPrint].
// If r is not a valid Unicode code point, it is interpreted as the Unicode
// replacement character U+FFFD.
func QuoteRune(r rune) string {
	return "'" + quoteRuneBody(r, false, false, '\'') + "'"
}

// QuoteRuneToASCII returns a single-quoted Go character literal representing
// the rune. The returned string uses Go escape sequences (\t, \n, \xFF,
// \u0100) for non-ASCII characters and non-printable characters as defined
// by [IsPrint].
// If r is not a valid Unicode code point, it is interpreted as the Unicode
// replacement character U+FFFD.
func QuoteRuneToASCII(r rune) string {
	return "'" + quoteRuneBody(r, true, false, '\'') + "'"
}

// QuoteRuneToGraphic returns a quoted Go rune literal, leaving a graphic rune
// unchanged.
func QuoteRuneToGraphic(r rune) string {
	return "'" + quoteRuneBody(r, false, true, '\'') + "'"
}

// IsPrint reports whether r is defined as printable by Go.
func IsPrint(r rune) bool {
	return unicode.IsPrint(r)
}

// IsGraphic reports whether r is defined as a Unicode graphic character.
func IsGraphic(r rune) bool {
	return unicode.IsGraphic(r)
}

// CanBackquote reports whether the string s can be represented
// unchanged as a single-line backquoted string without control
// characters other than tab.
func CanBackquote(s string) bool {
	for _, r := range s {
		if r == '`' || r == '\r' {
			return false
		}
		if r < 32 && r != '\t' {
			return false
		}
	}
	return true
}

// Unquote interprets s as a single-quoted, double-quoted,
// or backquoted Go string literal, returning the string value
// that s quotes.  (If s is single-quoted, it would be a Go
// character literal; Unquote returns the corresponding
// one-character string. For an empty character literal
// Unquote returns the empty string.)
func Unquote(s string) (string, error) {
	if len(s) < 2 {
		return "", newError("invalid syntax")
	}
	quote := s[0]
	if quote != '"' && quote != '\'' && quote != '`' {
		return "", newError("invalid syntax")
	}
	if s[len(s) - 1] != quote {
		return "", newError("invalid syntax")
	}
	body := s[1:len(s) - 1]
	var ok error
	if quote == '`' {
		if !CanBackquote(body) {
			return "", newError("invalid syntax")
		}
		return body, ok
	}
	if quote == '\'' {
		r, _, tail, err := UnquoteChar(body, quote)
		if err != nil || tail != "" {
			return "", newError("invalid syntax")
		}
		return string(r), ok
	}
	out := ""
	for body != "" {
		nextRune, _, nextTail, nextErr := UnquoteChar(body, quote)
		if nextErr != nil {
			return "", nextErr
		}
		out += string(nextRune)
		body = nextTail
	}
	return out, ok
}

// QuotedPrefix returns the valid quoted string at the beginning of s.
func QuotedPrefix(s string) (string, error) {
	if len(s) < 2 || s[0] != '"' && s[0] != '\'' && s[0] != '`' {
		return "", newError("invalid syntax")
	}
	quote := s[0]
	escaped := false
	for i := 1; i < len(s); i++ {
		value := s[i]
		if quote != '`' && value == '\\' && !escaped {
			escaped = true
			continue
		}
		if value == quote && !escaped {
			prefix := s[:i + 1]
			if _, err := Unquote(prefix); err != nil {
				return "", err
			}
			var ok error
			return prefix, ok
		}
		escaped = false
		if value == '\n' && quote != '`' {
			break
		}
	}
	return "", newError("invalid syntax")
}

// UnquoteChar decodes the first character or byte in the escaped string
// or character literal represented by the string s.
// It returns four values:
//
//  1. value, the decoded Unicode code point or byte value;
//  2. multibyte, a boolean indicating whether the decoded character requires a multibyte UTF-8 representation;
//  3. tail, the remainder of the string after the character; and
//  4. an error that will be nil if the character is syntactically valid.
//
// The second argument, quote, specifies the type of literal being parsed
// and therefore which escaped quote character is permitted.
// If set to a single quote, it permits the sequence \' and disallows unescaped '.
// If set to a double quote, it permits \" and disallows unescaped ".
// If set to zero, it does not permit either escape and allows both quote characters to appear unescaped.
func UnquoteChar(s string, quote byte) (rune, bool, string, error) {
	if s == "" {
		return 0, false, "", newError("invalid syntax")
	}
	var ok error
	if s[0:1] != "\\" {
		r, tail := firstRuneAndTail(s)
		if quote != byte(0) && byte(r) == quote {
			return 0, false, "", newError("invalid syntax")
		}
		if r < 32 {
			return 0, false, "", newError("invalid syntax")
		}
		return r, r >= 128, tail, ok
	}
	if len(s) < 2 {
		return 0, false, "", newError("invalid syntax")
	}
	esc := s[1:2]
	switch esc {
		case "a":
			return '\a', false, s[2:], ok
		case "b":
			return '\b', false, s[2:], ok
		case "f":
			return '\f', false, s[2:], ok
		case "n":
			return '\n', false, s[2:], ok
		case "r":
			return '\r', false, s[2:], ok
		case "t":
			return '\t', false, s[2:], ok
		case "v":
			return '\v', false, s[2:], ok
		case "\\":
			return '\\', false, s[2:], ok
		case "\"":
			if quote != byte(0) && quote != '"' {
				return 0, false, "", newError("invalid syntax")
			}
			return '"', false, s[2:], ok
		case "'":
			if quote != byte(0) && quote != '\'' {
				return 0, false, "", newError("invalid syntax")
			}
			return '\'', false, s[2:], ok
		case "x":
			xValue, xTail, xOK := parseFixedHexRune(s[2:], 2)
			if !xOK {
				return 0, false, "", newError("invalid syntax")
			}
			return rune(xValue), false, xTail, ok
		case "u":
			uValue, uTail, uOK := parseFixedHexRune(s[2:], 4)
			if !uOK || !validRuneValue(uValue) {
				return 0, false, "", newError("invalid syntax")
			}
			return rune(uValue), uValue >= 128, uTail, ok
		case "U":
			bigValue, bigTail, bigOK := parseFixedHexRune(s[2:], 8)
			if !bigOK || !validRuneValue(bigValue) {
				return 0, false, "", newError("invalid syntax")
			}
			return rune(bigValue), bigValue >= 128, bigTail, ok
		default:
			return 0, false, "", newError("invalid syntax")
	}
}

func quoteString(s string, ascii bool, graphic bool) string {
	out := "\""
	for _, r := range s {
		out += quoteRuneBody(r, ascii, graphic, '"')
	}
	return out + "\""
}

func quoteRuneBody(r rune, ascii bool, graphic bool, quote byte) string {
	if !validRuneValue(int(r)) {
		r = rune(65533)
	}
	switch r {
		case '\a':
			return "\\a"
		case '\b':
			return "\\b"
		case '\f':
			return "\\f"
		case '\n':
			return "\\n"
		case '\r':
			return "\\r"
		case '\t':
			return "\\t"
		case '\v':
			return "\\v"
		case '\\':
			return "\\\\"
		case '"':
			if quote == '"' {
				return "\\\""
			}
		case '\'':
			if quote == '\'' {
				return "\\'"
			}
	}
	value := int(r)
	if value < 32 || value == 127 {
		return "\\x" + fixedHex(value, 2)
	}
	if ascii && value >= 128 {
		if value <= 65535 {
			return "\\u" + fixedHex(value, 4)
		}
		return "\\U" + fixedHex(value, 8)
	}
	printable := unicode.IsPrint(r)
	if graphic {
		printable = unicode.IsGraphic(r)
	}
	if !printable {
		if value <= 255 {
			return "\\x" + fixedHex(value, 2)
		}
		if value <= 65535 {
			return "\\u" + fixedHex(value, 4)
		}
		return "\\U" + fixedHex(value, 8)
	}
	return string(r)
}

func firstRuneAndTail(s string) (rune, string) {
	for _, r := range s {
		return r, s[len(string(r)):]
	}
	return 0, ""
}

func parseFixedHexRune(s string, digits int) (int, string, bool) {
	if len(s) < digits {
		return 0, s, false
	}
	value := 0
	for i := 0; i < digits; i++ {
		digit, ok := hexValue(s[i:i + 1])
		if !ok {
			return 0, s, false
		}
		value = value * 16 + digit
	}
	return value, s[digits:], true
}

func fixedHex(value int, width int) string {
	digits := "0123456789abcdef"
	out := ""
	divisor := 1
	for scaleIndex := 1; scaleIndex < width; scaleIndex++ {
		divisor = divisor * 16
	}
	for digitIndex := 0; digitIndex < width; digitIndex++ {
		digit := (value / divisor) % 16
		out += digits[digit:digit + 1]
		divisor = divisor / 16
	}
	return out
}

func hexValue(ch string) (int, bool) {
	if ch >= "0" && ch <= "9" {
		return int(ch[0]) - 48, true
	}
	if ch >= "a" && ch <= "f" {
		return int(ch[0]) - 87, true
	}
	if ch >= "A" && ch <= "F" {
		return int(ch[0]) - 55, true
	}
	return 0, false
}

func validRuneValue(value int) bool {
	return value >= 0 && value <= 1114111 && (value < 55296 || value > 57343)
}
