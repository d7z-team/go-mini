package cmp_test

import (
	"cmp"
	"testing"
)

func TestCompareLessAndOr(t *testing.T) {
	if cmp.Compare(1, 2) != -1 || cmp.Compare("b", "a") != 1 || cmp.Compare(3, 3) != 0 {
		t.Fatalf("Compare returned an unexpected ordering")
	}
	zero := float64(0)
	nan := zero / zero
	if !cmp.Less(nan, 0.0) || cmp.Less(0.0, nan) || cmp.Compare(nan, nan) != 0 {
		t.Fatalf("NaN ordering is incorrect")
	}
	if cmp.Or(0, 0, 4, 5) != 4 || cmp.Or("", "value") != "value" {
		t.Fatalf("Or returned the wrong value")
	}
}
