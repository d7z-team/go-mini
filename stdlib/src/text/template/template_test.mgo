package template_test

import (
	"bytes"
	"testing"
	"text/template"
)

func TestTemplateParseAndExecute(t *testing.T) {
	tmpl, err := template.New("message").Parse(`{{if .Enabled}}{{.Name}}:{{range .Values}} {{.}}{{end}}{{else}}disabled{{end}}`)
	if err != nil {
		t.Fatalf("Parse returned error: %v", err)
	}
	data := struct {
		Enabled bool
		Name string
		Values []int
	}{Enabled: true, Name: "items", Values: []int{2, 4, 6}}
	var output bytes.Buffer
	if err := tmpl.Execute(&output, data); err != nil {
		t.Fatalf("Execute returned error: %v", err)
	}
	if output.String() != "items: 2 4 6" {
		t.Fatalf("Execute output = %q", output.String())
	}
}

func TestTemplateFunctionsAndOrderedMap(t *testing.T) {
	tmpl, err := template.New("map").Funcs(template.FuncMap{
		"double": func(value int) int {
			return value * 2
		},
	}).Parse(`{{range $key, $value := .}}{{$key}}={{double $value}};{{end}}`)
	if err != nil {
		t.Fatalf("Parse returned error: %v", err)
	}
	var output bytes.Buffer
	if err := tmpl.Execute(&output, map[string]int{"b": 2, "a": 1}); err != nil {
		t.Fatalf("Execute returned error: %v", err)
	}
	if output.String() != "a=2;b=4;" {
		t.Fatalf("ordered map output = %q", output.String())
	}
}
