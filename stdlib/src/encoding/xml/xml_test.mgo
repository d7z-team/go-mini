package xml_test

import (
	"encoding/xml"
	"strings"
	"testing"
)

type document struct {
	XMLName xml.Name `xml:"document"`
	ID int `xml:"id,attr"`
	Title string `xml:"title"`
	Items []string `xml:"items>item"`
}

func TestMarshalUnmarshalAndTokens(t *testing.T) {
	input := document{ID: 7, Title: "A & B", Items: []string{"one", "two"}}
	data, err := xml.Marshal(input)
	if err != nil {
		t.Fatal(err)
	}
	if string(data) != `<document id="7"><title>A &amp; B</title><items><item>one</item><item>two</item></items></document>` {
		t.Fatalf("Marshal = %q", data)
	}
	var output document
	if err := xml.Unmarshal(data, &output); err != nil {
		t.Fatal(err)
	}
	if output.ID != input.ID || output.Title != input.Title || len(output.Items) != 2 || output.Items[1] != "two" {
		t.Fatalf("Unmarshal = %#v", output)
	}
	decoder := xml.NewDecoder(strings.NewReader(`<root xmlns="urn:test"><child/></root>`))
	token, err := decoder.Token()
	if err != nil {
		t.Fatal(err)
	}
	start, ok := token.(xml.StartElement)
	if !ok || start.Name.Space != "urn:test" || start.Name.Local != "root" {
		t.Fatalf("first token = %#v", token)
	}
}
