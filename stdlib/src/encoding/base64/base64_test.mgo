package base64_test

import (
	"bytes"
	"encoding/base64"
	"io"
	"testing"
)

func TestBase64StandardAndURL(t *testing.T) {
	if base64.StdEncoding.EncodeToString([]byte("hello")) != "aGVsbG8=" {
		t.Fatal("StdEncoding returned the wrong text")
	}
	decoded, err := base64.StdEncoding.DecodeString("aGVsbG8=")
	if err != nil || string(decoded) != "hello" {
		t.Fatal("StdEncoding failed to decode")
	}
	if base64.URLEncoding.EncodeToString([]byte("a+b?")) != "YStiPw==" {
		t.Fatal("URLEncoding returned the wrong text")
	}
	urlDecoded, err := base64.URLEncoding.DecodeString("YStiPw==")
	if err != nil || string(urlDecoded) != "a+b?" {
		t.Fatal("URLEncoding failed to decode")
	}
}

func TestBase64RawAndCustomEncoding(t *testing.T) {
	if base64.RawStdEncoding.EncodeToString([]byte("hi")) != "aGk" {
		t.Fatal("RawStdEncoding returned the wrong text")
	}
	rawDecoded, err := base64.RawStdEncoding.DecodeString("aGk")
	if err != nil || string(rawDecoded) != "hi" {
		t.Fatal("RawStdEncoding failed to decode")
	}
	custom := base64.NewEncoding("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/").WithPadding(base64.NoPadding)
	if custom.EncodeToString([]byte("hi")) != "aGk" || custom.EncodedLen(2) != 3 || custom.DecodedLen(3) != 2 {
		t.Fatal("custom encoding length or output is wrong")
	}
	encoded := custom.AppendEncode([]byte("p:"), []byte("hi"))
	if string(encoded) != "p:aGk" {
		t.Fatal("AppendEncode returned the wrong text")
	}
	rawDecoded, err = custom.AppendDecode([]byte("p:"), []byte("aGk"))
	if err != nil || string(rawDecoded) != "p:hi" {
		t.Fatal("AppendDecode returned the wrong data")
	}
}

func TestBase64BufferMethods(t *testing.T) {
	encoded := make([]byte, base64.StdEncoding.EncodedLen(2))
	base64.StdEncoding.Encode(encoded, []byte("hi"))
	if string(encoded) != "aGk=" {
		t.Fatal("Encode returned the wrong text")
	}
	decoded := make([]byte, base64.StdEncoding.DecodedLen(len(encoded)))
	n, err := base64.StdEncoding.Decode(decoded, encoded)
	if err != nil || n != 2 || string(decoded[:n]) != "hi" {
		t.Fatal("Decode returned the wrong data")
	}
	n, err = base64.StdEncoding.Decode(decoded, []byte("aGk=\n"))
	if err != nil || n != 2 || string(decoded[:n]) != "hi" {
		t.Fatal("Decode did not accept line breaks")
	}
	strict := base64.RawStdEncoding.Strict()
	if _, err = strict.DecodeString("aGm"); err == nil {
		t.Fatal("Strict accepted non-zero trailing bits")
	}
}

func TestBase64RejectsMalformedInput(t *testing.T) {
	for _, text := range []string{"a", "a=", "a===", "aG$=", "aGk=aaaa", "aGk"} {
		if _, err := base64.StdEncoding.DecodeString(text); err == nil {
			t.Fatalf("DecodeString accepted malformed input %q", text)
		}
	}
	if _, err := base64.RawStdEncoding.DecodeString("a="); err == nil {
		t.Fatal("raw decoder accepted padding")
	}
}

func TestBase64StreamCodec(t *testing.T) {
	var encoded bytes.Buffer
	writer := base64.NewEncoder(base64.StdEncoding, &encoded)
	if n, err := writer.Write([]byte("hello")); err != nil || n != 5 {
		t.Fatalf("NewEncoder.Write = %d, %v", n, err)
	}
	if encoded.String() != "aGVs" {
		t.Fatalf("NewEncoder wrote unflushed tail: %q", encoded.String())
	}
	if err := writer.Close(); err != nil || encoded.String() != "aGVsbG8=" {
		t.Fatalf("NewEncoder.Close = %q, %v", encoded.String(), err)
	}
	reader := base64.NewDecoder(base64.StdEncoding, bytes.NewBufferString("aGVs\nbG8="))
	decoded, err := io.ReadAll(reader)
	if err != nil || string(decoded) != "hello" {
		t.Fatalf("NewDecoder = %q, %v", string(decoded), err)
	}
}
