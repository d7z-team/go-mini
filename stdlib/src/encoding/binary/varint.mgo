package binary

import "io"

const (
	// MaxVarintLen16 is the maximum length of a varint-encoded 16-bit integer.
	MaxVarintLen16 = 3

	// MaxVarintLen32 is the maximum length of a varint-encoded 32-bit integer.
	MaxVarintLen32 = 5
	// MaxVarintLen64 is the maximum length of a varint-encoded 64-bit integer.
	MaxVarintLen64 = 10
)

// AppendUvarint appends the varint encoding of x to buf.
func AppendUvarint(buf []byte, x uint64) []byte {
	for x >= 0x80 {
		buf = append(buf, byte(x) | 0x80)
		x >>= 7
	}
	return append(buf, byte(x))
}

// PutUvarint encodes x into buf and returns the number of bytes written.
func PutUvarint(buf []byte, x uint64) int {
	index := 0
	for x >= 0x80 {
		buf[index] = byte(x) | 0x80
		x >>= 7
		index++
	}
	buf[index] = byte(x)
	return index + 1
}

// Uvarint decodes an unsigned integer from buf.
func Uvarint(buf []byte) (uint64, int) {
	var value uint64
	for i, b := range buf {
		if i == 10 || i == 9 && b > 1 {
			return 0, -(i + 1)
		}
		if b < 0x80 {
			return value | uint64(b) << uint(7 * i), i + 1
		}
		value |= uint64(b & 0x7f) << uint(7 * i)
	}
	return 0, 0
}

// AppendVarint appends the varint encoding of x to buf.
func AppendVarint(buf []byte, x int64) []byte {
	value := uint64(x) << 1
	if x < 0 {
		value = ^value
	}
	return AppendUvarint(buf, value)
}

// PutVarint encodes x into buf and returns the number of bytes written.
func PutVarint(buf []byte, x int64) int {
	value := uint64(x) << 1
	if x < 0 {
		value = ^value
	}
	return PutUvarint(buf, value)
}

// Varint decodes a signed integer from buf.
func Varint(buf []byte) (int64, int) {
	value, count := Uvarint(buf)
	result := int64(value >> 1)
	if value & 1 != 0 {
		result = ^result
	}
	return result, count
}

// ReadUvarint reads an encoded unsigned integer from r.
func ReadUvarint(r io.ByteReader) (uint64, error) {
	var value uint64
	for i := 0; i < 10; i++ {
		b, err := r.ReadByte()
		if err != nil {
			if i > 0 && err == io.EOF {
				return 0, io.ErrUnexpectedEOF
			}
			return 0, err
		}
		if b < 0x80 {
			if i == 9 && b > 1 {
				return 0, errOverflow
			}
			return value | uint64(b) << uint(7 * i), nil
		}
		value |= uint64(b & 0x7f) << uint(7 * i)
	}
	return 0, errOverflow
}

// ReadVarint reads an encoded signed integer from r.
func ReadVarint(r io.ByteReader) (int64, error) {
	value, err := ReadUvarint(r)
	result := int64(value >> 1)
	if value & 1 != 0 {
		result = ^result
	}
	return result, err
}
