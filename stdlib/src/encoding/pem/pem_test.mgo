package pem_test

import (
	"encoding/pem"
	"testing"
)

func TestPEMRoundTrip(t *testing.T) {
	block := &pem.Block{
		Type: "MINIGO DATA",
		Headers: map[string]string{"Name": "example"},
		Bytes: []byte{0, 1, 2, 253, 254, 255},
	}
	encoded := pem.EncodeToMemory(block)
	decoded, rest := pem.Decode(append(encoded, []byte("tail")...))
	if decoded == nil || decoded.Type != block.Type || decoded.Headers["Name"] != "example" {
		t.Fatalf("Decode = %v", decoded)
	}
	if len(decoded.Bytes) != len(block.Bytes) || string(rest) != "tail" {
		t.Fatalf("Decode bytes/rest = %v, %q", decoded.Bytes, string(rest))
	}
	for i := range block.Bytes {
		if decoded.Bytes[i] != block.Bytes[i] {
			t.Fatalf("Decode byte %d = %d", i, decoded.Bytes[i])
		}
	}
}

func TestPEMRejectsMalformedBlock(t *testing.T) {
	block, rest := pem.Decode([]byte("not a PEM block"))
	if block != nil || string(rest) != "not a PEM block" {
		t.Fatalf("Decode malformed = %v, %q", block, string(rest))
	}
}
