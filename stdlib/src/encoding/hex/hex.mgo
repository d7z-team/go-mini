// Package hex implements hexadecimal encoding and decoding.
package hex

import (
	"errors"
	"io"
	"strings"
)

const digits = "0123456789abcdef"

// ErrLength reports an attempt to decode an odd-length input
// using [Decode] or [DecodeString].
// The stream-based Decoder returns [io.ErrUnexpectedEOF] instead of ErrLength.
var ErrLength = errors.New("encoding/hex: odd length hex string")

// InvalidByteError values describe errors resulting from an invalid byte in a hex string.
type InvalidByteError byte

// Error returns a description of the invalid hexadecimal byte.
func (e InvalidByteError) Error() string {
	return "encoding/hex: invalid byte: " + string([]byte{byte(e)})
}

// EncodedLen returns the length of an encoding of n source bytes.
// Specifically, it returns n * 2.
func EncodedLen(n int) int {
	return n * 2
}

// DecodedLen returns the length of a decoding of x source bytes.
// Specifically, it returns x / 2.
func DecodedLen(n int) int {
	return n / 2
}

// Encode encodes src into [EncodedLen](len(src))
// bytes of dst. As a convenience, it returns the number
// of bytes written to dst, but this value is always [EncodedLen](len(src)).
// Encode implements hexadecimal encoding.
func Encode(dst []byte, src []byte) int {
	for i, value := range src {
		dst[i * 2] = digits[value >> 4]
		dst[i * 2 + 1] = digits[value & 15]
	}
	return len(src) * 2
}

// AppendEncode appends the hexadecimally encoded src to dst
// and returns the extended buffer.
func AppendEncode(dst []byte, src []byte) []byte {
	start := len(dst)
	dst = append(dst, make([]byte, EncodedLen(len(src)))...)
	Encode(dst[start:], src)
	return dst
}

// EncodeToString returns the hexadecimal encoding of src.
func EncodeToString(src []byte) string {
	dst := make([]byte, EncodedLen(len(src)))
	Encode(dst, src)
	return string(dst)
}

// Decode decodes src into [DecodedLen](len(src)) bytes,
// returning the actual number of bytes written to dst.
//
// Decode expects that src contains only hexadecimal
// characters and that src has even length.
// If the input is malformed, Decode returns the number
// of bytes decoded before the error.
func Decode(dst []byte, src []byte) (int, error) {
	decoded := 0
	for len(src) >= 2 {
		high, ok := hexValue(src[0])
		if !ok {
			return decoded, InvalidByteError(src[0])
		}
		low, ok := hexValue(src[1])
		if !ok {
			return decoded, InvalidByteError(src[1])
		}
		dst[decoded] = high << 4 | low
		decoded++
		src = src[2:]
	}
	if len(src) != 0 {
		if _, ok := hexValue(src[0]); !ok {
			return decoded, InvalidByteError(src[0])
		}
		return decoded, ErrLength
	}
	return decoded, nil
}

// AppendDecode appends the hexadecimally decoded src to dst
// and returns the extended buffer.
// If the input is malformed, it returns the partially decoded src and an error.
func AppendDecode(dst []byte, src []byte) ([]byte, error) {
	start := len(dst)
	dst = append(dst, make([]byte, DecodedLen(len(src)))...)
	n, err := Decode(dst[start:], src)
	return dst[:start + n], err
}

// DecodeString returns the bytes represented by the hexadecimal string s.
//
// DecodeString expects that src contains only hexadecimal
// characters and that src has even length.
// If the input is malformed, DecodeString returns
// the bytes decoded before the error.
func DecodeString(text string) ([]byte, error) {
	dst := make([]byte, DecodedLen(len(text)))
	n, err := Decode(dst, []byte(text))
	return dst[:n], err
}

// Dump returns a string containing a canonical hexadecimal and ASCII dump.
func Dump(data []byte) string {
	if len(data) == 0 {
		return ""
	}
	var output strings.Builder
	dumper := Dumper(&output)
	_, _ = dumper.Write(data)
	_ = dumper.Close()
	return output.String()
}

type encoder struct {
	w io.Writer
}

// NewEncoder returns an [io.Writer] that writes lowercase hexadecimal characters to w.
func NewEncoder(w io.Writer) io.Writer {
	return &encoder{w: w}
}

func (e *encoder) Write(p []byte) (int, error) {
	encoded := make([]byte, EncodedLen(len(p)))
	Encode(encoded, p)
	n, err := e.w.Write(encoded)
	if n > len(encoded) {
		n = len(encoded)
	}
	return n / 2, err
}

type decoder struct {
	r io.Reader
	pending []byte
	done bool
}

// NewDecoder returns an [io.Reader] that decodes hexadecimal characters from r.
// NewDecoder expects that r contain only an even number of hexadecimal characters.
func NewDecoder(r io.Reader) io.Reader {
	return &decoder{r: r}
}

func (d *decoder) Read(p []byte) (int, error) {
	for len(d.pending) < len(p) * 2 && !d.done {
		chunk := make([]byte, 512)
		n, err := d.r.Read(chunk)
		if n > 0 {
			d.pending = append(d.pending, chunk[:n]...)
		}
		if err != nil {
			if err != io.EOF {
				return 0, err
			}
			d.done = true
		}
		if n == 0 && err == nil {
			break
		}
	}
	available := len(d.pending) / 2
	if available > len(p) {
		available = len(p)
	}
	if available > 0 {
		used := available * 2
		n, err := Decode(p[:available], d.pending[:used])
		d.pending = d.pending[used:]
		return n, err
	}
	if d.done {
		if len(d.pending) != 0 {
			return 0, ErrLength
		}
		return 0, io.EOF
	}
	return 0, nil
}

func hexValue(value byte) (byte, bool) {
	switch {
		case value >= '0' && value <= '9':
			return value - '0', true
		case value >= 'a' && value <= 'f':
			return value - 'a' + 10, true
		case value >= 'A' && value <= 'F':
			return value - 'A' + 10, true
		default:
			return 0, false
	}
}

// Dumper returns a writer that writes a canonical hexadecimal and ASCII dump.
func Dumper(w io.Writer) io.WriteCloser {
	return &dumper{w: w}
}

type dumper struct {
	w io.Writer
	right [18]byte
	buffer [14]byte
	used int
	offset uint
	closed bool
}

func printable(value byte) byte {
	if value < 32 || value > 126 {
		return '.'
	}
	return value
}

func (d *dumper) Write(data []byte) (int, error) {
	if d.closed {
		return 0, errors.New("encoding/hex: dumper closed")
	}
	written := 0
	for i := 0; i < len(data); i++ {
		if d.used == 0 {
			d.buffer[0] = byte(d.offset >> 24)
			d.buffer[1] = byte(d.offset >> 16)
			d.buffer[2] = byte(d.offset >> 8)
			d.buffer[3] = byte(d.offset)
			Encode(d.buffer[4:], d.buffer[:4])
			d.buffer[12] = ' '
			d.buffer[13] = ' '
			if _, err := d.w.Write(d.buffer[4:]); err != nil {
				return written, err
			}
		}
		Encode(d.buffer[:], data[i:i + 1])
		d.buffer[2] = ' '
		length := 3
		if d.used == 7 {
			d.buffer[3] = ' '
			length = 4
		} else if d.used == 15 {
			d.buffer[3] = ' '
			d.buffer[4] = '|'
			length = 5
		}
		if _, err := d.w.Write(d.buffer[:length]); err != nil {
			return written, err
		}
		d.right[d.used] = printable(data[i])
		d.used++
		d.offset++
		written++
		if d.used == 16 {
			d.right[16] = '|'
			d.right[17] = '\n'
			if _, err := d.w.Write(d.right[:]); err != nil {
				return written, err
			}
			d.used = 0
		}
	}
	return written, nil
}

func (d *dumper) Close() error {
	if d.closed {
		return nil
	}
	d.closed = true
	if d.used == 0 {
		return nil
	}
	d.buffer[0] = ' '
	d.buffer[1] = ' '
	d.buffer[2] = ' '
	d.buffer[3] = ' '
	d.buffer[4] = '|'
	count := d.used
	for d.used < 16 {
		length := 3
		if d.used == 7 {
			length = 4
		} else if d.used == 15 {
			length = 5
		}
		if _, err := d.w.Write(d.buffer[:length]); err != nil {
			return err
		}
		d.used++
	}
	d.right[count] = '|'
	d.right[count + 1] = '\n'
	_, err := d.w.Write(d.right[:count + 2])
	return err
}
