// Package encoding defines interfaces shared by packages that convert data
// to and from byte-level and textual representations.
package encoding

// BinaryMarshaler is implemented by a value that can marshal itself into a
// binary form.
type BinaryMarshaler interface {
	// MarshalBinary encodes the receiver into a binary form.
	MarshalBinary() (data []byte, err error)
}

// BinaryUnmarshaler is implemented by a value that can unmarshal a binary
// representation of itself. UnmarshalBinary must copy data if it retains it
// after returning.
type BinaryUnmarshaler interface {
	// UnmarshalBinary decodes the form generated by MarshalBinary.
	UnmarshalBinary(data []byte) error
}

// BinaryAppender is implemented by a value that can append its binary
// representation. AppendBinary must preserve the existing buffer prefix.
type BinaryAppender interface {
	// AppendBinary appends the binary representation to buffer and returns the extended buffer.
	AppendBinary(buffer []byte) ([]byte, error)
}

// TextMarshaler is implemented by a value that can marshal itself into
// UTF-8-encoded text.
type TextMarshaler interface {
	// MarshalText encodes the receiver into UTF-8 text.
	MarshalText() (text []byte, err error)
}

// TextUnmarshaler is implemented by a value that can unmarshal a textual
// representation of itself. UnmarshalText must copy text if it retains it
// after returning.
type TextUnmarshaler interface {
	// UnmarshalText decodes the form generated by MarshalText.
	UnmarshalText(text []byte) error
}

// TextAppender is implemented by a value that can append its textual
// representation. AppendText must preserve the existing buffer prefix.
type TextAppender interface {
	// AppendText appends the textual representation to buffer and returns the extended buffer.
	AppendText(buffer []byte) ([]byte, error)
}
