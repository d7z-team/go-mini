package base32_test

import (
	"bytes"
	"encoding/base32"
	"io"
	"testing"
)

func TestBase32Codec(t *testing.T) {
	encoded := base32.StdEncoding.EncodeToString([]byte("foobar"))
	if encoded != "MZXW6YTBOI======" {
		t.Fatalf("EncodeToString = %q", encoded)
	}
	decoded, err := base32.StdEncoding.DecodeString(encoded)
	if err != nil || string(decoded) != "foobar" {
		t.Fatalf("DecodeString = %q, %v", string(decoded), err)
	}
	raw := base32.StdEncoding.WithPadding(base32.NoPadding)
	if raw.EncodeToString([]byte("foo")) != "MZXW6" {
		t.Fatal("raw encoding returned the wrong text")
	}
}

func TestBase32StreamCodec(t *testing.T) {
	var encoded bytes.Buffer
	writer := base32.NewEncoder(base32.StdEncoding, &encoded)
	if _, err := writer.Write([]byte("foo")); err != nil {
		t.Fatal(err)
	}
	if _, err := writer.Write([]byte("bar")); err != nil {
		t.Fatal(err)
	}
	if err := writer.Close(); err != nil {
		t.Fatal(err)
	}
	decoded, err := io.ReadAll(base32.NewDecoder(base32.StdEncoding, bytes.NewBufferString(encoded.String())))
	if err != nil || string(decoded) != "foobar" {
		t.Fatalf("stream round trip = %q, %v", string(decoded), err)
	}
}
