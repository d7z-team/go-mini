package time

// Sleep pauses the current goroutine for at least the duration d.
// A negative or zero duration causes Sleep to return immediately.
func Sleep(duration Duration) {
	if duration <= 0 {
		return
	}
	signal := make(chan bool, 1)
	runtimeTimerStart(signal, int64(duration), 0)
	<-signal
}

// The Timer type represents a single event.
// When the Timer expires, the current time will be sent on C,
// unless the Timer was created by [AfterFunc].
// A Timer must be created with [NewTimer] or AfterFunc.
type Timer struct {
	// C receives the current time when a channel-based Timer expires.
	C <-chan Time
	channel chan Time
	signal chan bool
	active bool
	generation int
	callback func()
}

// NewTimer creates a Timer that sends the current time on a buffered channel
// after at least duration d.
func NewTimer(duration Duration) *Timer {
	channel := make(chan Time, 1)
	timer := &Timer{C: channel, channel: channel, active: true}
	timer.start(duration)
	return timer
}

// AfterFunc waits for the duration to elapse and then calls f
// in its own goroutine. It returns a [Timer] that can
// be used to cancel the call using its Stop method.
// The returned Timer's C field is not used and will be nil.
func AfterFunc(duration Duration, callback func()) *Timer {
	timer := &Timer{active: true, callback: callback}
	timer.start(duration)
	return timer
}

func (t *Timer) start(duration Duration) {
	t.generation++
	generation := t.generation
	signal := make(chan bool, 1)
	t.signal = signal
	runtimeTimerStart(signal, int64(duration), 0)
	go func() {
		_, ok := <-signal
		if !ok {
			return
		}
		if t.callback != nil {
			if t.generation == generation {
				t.active = false
			}
			t.callback()
			return
		}
		if t.active && t.generation == generation {
			t.active = false
			t.channel <- Now()
		}
	}()
}

// Stop prevents the [Timer] from firing.
// It returns true if the call stops the timer, false if the timer has already
// expired or been stopped.
//
// For a func-based timer created with [AfterFunc](d, f),
// if t.Stop returns false, then the timer has already expired
// and the function f has been started in its own goroutine;
// Stop does not wait for f to complete before returning.
// If the caller needs to know whether f is completed,
// it must coordinate with f explicitly.
func (t *Timer) Stop() bool {
	if t == nil || t.signal == nil {
		return false
	}
	stopped := runtimeTimerStop(t.signal)
	if stopped {
		t.active = false
		t.generation++
	}
	return stopped
}

// Reset changes the timer to expire after duration d.
// It returns true if the timer had been active, false if the timer had
// expired or been stopped.
//
// For a func-based timer created with [AfterFunc](d, f), Reset either reschedules
// when f will run, in which case Reset returns true, or schedules f
// to run again, in which case it returns false.
// When Reset returns false, Reset neither waits for the prior f to
// complete before returning nor does it guarantee that the subsequent
// goroutine running f does not run concurrently with the prior
// one. If the caller needs to know whether the prior execution of
// f is completed, it must coordinate with f explicitly.
func (t *Timer) Reset(duration Duration) bool {
	if t == nil {
		return false
	}
	active := t.signal != nil && runtimeTimerStop(t.signal)
	t.active = true
	t.start(duration)
	return active
}

// After waits for the duration to elapse and then sends the current time
// on the returned channel.
// It is equivalent to [NewTimer](d).C.
func After(duration Duration) <-chan Time {
	return NewTimer(duration).C
}

// A Ticker holds a channel that delivers ticks of a clock at intervals.
type Ticker struct {
	// The channel on which the ticks are delivered.
	C <-chan Time
	channel chan Time
	signal chan bool
	active bool
	generation int
}

// NewTicker returns a Ticker that sends the current time after each positive
// duration interval. It panics when duration is not positive.
func NewTicker(duration Duration) *Ticker {
	if duration <= 0 {
		panic("non-positive interval for NewTicker")
	}
	channel := make(chan Time, 1)
	ticker := &Ticker{C: channel, channel: channel, active: true}
	ticker.start(duration)
	return ticker
}

func (t *Ticker) start(duration Duration) {
	t.generation++
	generation := t.generation
	signal := make(chan bool, 1)
	t.signal = signal
	runtimeTimerStart(signal, int64(duration), int64(duration))
	go func() {
		for {
			_, ok := <-signal
			if !ok {
				return
			}
			if t.active && t.generation == generation {
				t.channel <- Now()
			}
		}
	}()
}

// Stop turns off a ticker. After Stop, no more ticks will be sent.
// Stop does not close the channel, to prevent a concurrent goroutine
// reading from the channel from seeing an erroneous tick.
func (t *Ticker) Stop() {
	if t == nil {
		return
	}
	if t.signal != nil {
		runtimeTimerStop(t.signal)
	}
	t.active = false
	t.generation++
}

// Reset stops a ticker and resets its period to the specified duration.
// The next tick will arrive after the new period elapses. The duration d
// must be greater than zero; if not, Reset will panic.
func (t *Ticker) Reset(duration Duration) {
	if duration <= 0 {
		panic("non-positive interval for Ticker.Reset")
	}
	if t.signal != nil {
		runtimeTimerStop(t.signal)
	}
	t.active = true
	t.start(duration)
}

// Tick is a convenience wrapper for [NewTicker] providing access to the ticking
// channel only. Unlike NewTicker, Tick will return nil if d <= 0.
func Tick(duration Duration) <-chan Time {
	if duration <= 0 {
		return nil
	}
	return NewTicker(duration).C
}
