package time

import (
	"encoding/binary"
	"errors"
	"strconv"
	"unicode/utf8"
)

// MarshalText implements the [encoding.TextMarshaler] interface. The output
// matches that of calling the [Time.AppendText] method.
//
// See [Time.AppendText] for more information.
func (t Time) MarshalText() ([]byte, error) {
	_, offset := t.Zone()
	if t.Year() < 0 || t.Year() > 9999 || offset <= -86400 || offset >= 86400 {
		return nil, errors.New("time: cannot represent instant as RFC3339")
	}
	return []byte(t.Format(RFC3339Nano)), nil
}

// AppendText implements the [encoding.TextAppender] interface.
// The time is formatted in RFC 3339 format with sub-second precision.
// If the timestamp cannot be represented as valid RFC 3339
// (e.g., the year is out of range), then an error is returned.
func (t Time) AppendText(buffer []byte) ([]byte, error) {
	text, err := t.MarshalText()
	return append(buffer, text...), err
}

// UnmarshalText implements the [encoding.TextUnmarshaler] interface.
// The time must be in the RFC 3339 format.
func (t *Time) UnmarshalText(data []byte) error {
	value, err := Parse(RFC3339Nano, string(data))
	if err == nil {
		*t = value
	}
	return err
}

// MarshalJSON implements the [encoding/json.Marshaler] interface.
// The time is a quoted string in the RFC 3339 format with sub-second precision.
// If the timestamp cannot be represented as valid RFC 3339
// (e.g., the year is out of range), then an error is reported.
func (t Time) MarshalJSON() ([]byte, error) {
	text, err := t.MarshalText()
	if err != nil {
		return nil, err
	}
	return []byte(strconv.Quote(string(text))), nil
}

// UnmarshalJSON implements the [encoding/json.Unmarshaler] interface.
// The time must be a quoted string in the RFC 3339 format.
func (t *Time) UnmarshalJSON(data []byte) error {
	if string(data) == "null" {
		return nil
	}
	value, err := strconv.Unquote(string(data))
	if err != nil {
		return err
	}
	return t.UnmarshalText([]byte(value))
}

// AppendBinary implements the [encoding.BinaryAppender] interface.
func (t Time) AppendBinary(buffer []byte) ([]byte, error) {
	name, offset := t.Zone()
	if !utf8.ValidString(name) || uint64(len(name)) > uint64(1 << 32 - 1) || offset < -1 << 31 || offset > 1 << 31 - 1 || t.nsec < 0 || t.nsec >= int(Second) {
		return buffer, errors.New("time: invalid binary value")
	}
	header := make([]byte, 25)
	copy(header, "MGOT")
	header[4] = 1
	binary.BigEndian.PutUint64(header[5:13], uint64(t.absSec))
	binary.BigEndian.PutUint32(header[13:17], uint32(t.nsec))
	binary.BigEndian.PutUint32(header[17:21], uint32(int32(offset)))
	binary.BigEndian.PutUint32(header[21:25], uint32(len(name)))
	buffer = append(buffer, header...)
	return append(buffer, name...), nil
}

// MarshalBinary implements the [encoding.BinaryMarshaler] interface.
func (t Time) MarshalBinary() ([]byte, error) {
	return t.AppendBinary([]byte{})
}

// GobEncode implements the gob.GobEncoder interface.
func (t Time) GobEncode() ([]byte, error) {
	return t.MarshalBinary()
}

// UnmarshalBinary implements the [encoding.BinaryUnmarshaler] interface.
func (t *Time) UnmarshalBinary(data []byte) error {
	if len(data) < 25 || string(data[:4]) != "MGOT" || data[4] != 1 {
		return errors.New("time: invalid binary data")
	}
	sec := int64(binary.BigEndian.Uint64(data[5:13]))
	nsec := int(binary.BigEndian.Uint32(data[13:17]))
	offset := int(int32(binary.BigEndian.Uint32(data[17:21])))
	length := uint64(binary.BigEndian.Uint32(data[21:25]))
	if nsec >= int(Second) || length != uint64(len(data) - 25) || !utf8.Valid(data[25:]) {
		return errors.New("time: invalid binary data")
	}
	value := Time{absSec: sec, nsec: nsec, loc: FixedZone(string(data[25:]), offset)}
	*t = value
	return nil
}

// GobDecode implements the gob.GobDecoder interface.
func (t *Time) GobDecode(data []byte) error {
	return t.UnmarshalBinary(data)
}
