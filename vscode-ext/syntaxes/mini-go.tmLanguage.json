{
  "comment": "Code generated by mini-go-dev vscode-grammar; DO NOT EDIT.",
  "name": "Mini-Go",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "builtins": {
      "patterns": [
        {
          "match": "\\b(?:append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b",
          "name": "support.function.builtin.mgo"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//.*",
          "name": "comment.line.double-slash.mgo"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.mgo"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|map|package|range|return|select|struct|switch|type|var)\\b",
          "name": "keyword.control.mgo"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(?:0[xX][0-9a-fA-F_]+(?:\\.[0-9a-fA-F_]*)?(?:[pP][+-]?[0-9_]+)?|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]*)?(?:[eE][+-]?[0-9_]+)?)(?:i)?\\b",
          "name": "constant.numeric.mgo"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.mgo",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.mgo"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.mgo",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.mgo"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.raw.mgo"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(?:any|bool|byte|complex128|complex64|error|float32|float64|int|int16|int32|int64|int8|rune|string|uint|uint16|uint32|uint64|uint8|uintptr)\\b",
          "name": "storage.type.mgo"
        }
      ]
    }
  },
  "scopeName": "source.mgo"
}
