package main

type Pair struct {
	Name string
	Count uint64
}
type NamedKey int
func main() {}
func Answer() int { return 42 }
func StepAnswer() int {
	value := 40
	value = value + 2
	return value
}
func Add(left, right int) int { return left + right }
func EchoInt64(value int64) int64 { return value }
func EchoUint64(value uint64) uint64 { return value }
func EchoFloat32(value float32) float32 { return value }
func EchoFloat64(value float64) float64 { return value }
func EchoComplex64(value complex64) complex64 { return value }
func EchoComplex128(value complex128) complex128 { return value }
func EchoString(value string) string { return value }
func EchoBytes(value []byte) []byte { return value }
func EchoArray(value [3]int) [3]int { return value }
func EchoSlice(value []int) []int { return value }
func EchoMap(value map[string]int) map[string]int { return value }
func EchoPair(value Pair) Pair { return value }
func EchoAny(value any) any { return value }
func NilSlice() []int { return nil }
func BigString() string { return "12345" }
func BigSlice() []int { return []int{1, 2, 3} }
func Endless() { for {} }
func Inner(value int) int { return value + 1 }
func Outer() int {
	value := 41
	value = Inner(value)
	return value
}
func ByteMutation() int {
	values := []byte{1, 2, 3, 4}
	view := values[1:3]
	view[0] = 9
	values = append(values, 5, 6, 7, 8)
	copy(values[2:], values[:4])
	text := string(values)
	return int(view[0]) + len(text) + int(values[2])
}
func writeArrayView(values []byte) { values[0] = 9 }
func ArraySliceMutation() int {
	values := [4]byte{1, 2, 3, 4}
	first := values[1:3]
	second := values[:]
	writeArrayView(first)
	values[2] = 8
	grown := append(first, 5, 6, 7)
	grown[0] = 6
	return int(values[1])*1000 + int(first[1])*100 + int(second[2])*10 + int(grown[0])
}
func ScalarMap() int {
	values := map[NamedKey]int{NamedKey(1): 40}
	values[NamedKey(2)] = 2
	delete(values, NamedKey(1))
	return values[NamedKey(2)]
}
func GrowMap() int {
	values := make(map[int]int)
	values[1] = 1
	values[2] = 2
	values[3] = 3
	return 1
}
